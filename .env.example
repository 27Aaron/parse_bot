# 在 https://my.telegram.org/apps 申请，供内置 TDLib 直连 Telegram 使用。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 从 BotFather 获取。
TELEGRAM_BOT_TOKEN=

# 程序运行数据根目录。
DATA_DIR=./data

# 可选：要求用户必须加入的公开频道用户名；删除或留空则允许所有私聊用户。
# Bot 必须是该频道的管理员。
REQUIRED_CHANNEL_ID=

# 从腾讯元宝实际 API 请求的 Cookie 请求头复制。
# Cookie 通常包含分号和空格，因此必须使用单引号。
WECHAT_YUANBAO_COOKIE=''

# 可选：日志过滤级别。
RUST_LOG=parse_bot=info,warn

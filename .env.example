# Rust Bot 使用；从 BotFather 获取。
TELEGRAM_BOT_TOKEN=

# 自建 telegram-bot-api 的根地址。大文件必须使用 --local 模式。
TELEGRAM_BOT_API_URL=http://127.0.0.1:8081

# 可选：要求用户必须加入的公开频道用户名；删除或留空则允许所有私聊用户。
# Bot 必须是该频道的管理员。
REQUIRED_CHANNEL_ID=

# 从腾讯元宝实际 API 请求的 Cookie 请求头复制，不要提交到 Git。
# Cookie 通常包含分号和空格，因此必须使用单引号。
WECHAT_YUANBAO_COOKIE=''

# Bot 与本地 telegram-bot-api 都必须能访问的目录。
MEDIA_SHARED_DIR=./data/media
DATABASE_URL=sqlite:./data/state.db

WECHAT_RESOLVE_TIMEOUT_SECS=30
WECHAT_DOWNLOAD_TIMEOUT_SECS=7200
WECHAT_MEDIA_HOSTS=finder.video.qq.com,findermp.video.qq.com,finder.video.wechat.com,findermp.video.wechat.com
MEDIA_MAX_SOURCE_BYTES=2000000000
TELEGRAM_HARD_LIMIT_BYTES=2000000000

# 只有明确使用远端 Bot API 时才开启；官方云 API 首次上传只有 50 MB。
ALLOW_REMOTE_BOT_API=false
RUST_LOG=parse_bot=info,warn

# 以下两个值只供 telegram-bot-api 进程使用，Rust Bot 不读取。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

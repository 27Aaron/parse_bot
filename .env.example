# 在 https://my.telegram.org/apps 申请，供内置 TDLib 直连 Telegram 使用。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 从 BotFather 获取。
TELEGRAM_BOT_TOKEN=

# 程序运行数据根目录；每个 Bot 实例必须独占，生产部署时需持久化。
# 程序会在其下管理 state.db（设置与文件缓存）、media/（临时媒体）以及
# tdlib/database/ 和 tdlib/files/（TDLib 授权、连接与文件状态）。
DATA_DIR=./data

# 可选：要求用户必须加入的公开频道用户名；删除或留空则允许所有私聊用户。
# Bot 必须是该频道的管理员。
REQUIRED_CHANNEL_ID=

# 从腾讯元宝实际 API 请求的 Cookie 请求头复制，不要提交到 Git。
# Cookie 通常包含分号和空格，因此必须使用单引号。
WECHAT_YUANBAO_COOKIE=''

# 可选：日志过滤级别。
RUST_LOG=parse_bot=info,warn
